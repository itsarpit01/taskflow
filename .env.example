# Backend Environment Variables
# Copy to .env and fill in values. Never commit the real .env file.

PORT=3001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/taskflow?appName=Cluster0
FRONTEND_URL=http://localhost:5173

# Frontend (Vite) - set at build time
VITE_API_URL=/api